                                    </div>
                                    <div class="telemetry-card" style="min-height: 80px; padding: 0.8rem 0.5rem;">
                                        <div class="telemetry-label">Recycle Flow</div>
                                        <div class="telemetry-val" style="font-size: 1.4rem;"><span id="calc-rec-flow">-</span> <span style="font-size: 0.75rem; font-weight: normal; color: var(--text-secondary);">mÂ³/h</span></div>
                                    </div>
                                    <div class="telemetry-card" style="min-height: 80px; padding: 0.8rem 0.5rem;">
                                        <div class="telemetry-label">Blended Feed Flow</div>
                                        <div class="telemetry-val" style="font-size: 1.4rem;"><span id="calc-rec-blend-flow">-</span> <span style="font-size: 0.75rem; font-weight: normal; color: var(--text-secondary);">mÂ³/h</span></div>
                                    </div>
                                </div>
                                <div id="calc-rec-warning" style="display: none; background: rgba(231, 76, 60, 0.1); color: #c0392b; padding: 0.8rem; margin-top: 1rem; border-radius: 6px; font-size: 0.9rem; font-weight: 500;">
                                    <i class="fa-solid fa-triangle-exclamation"></i> <span id="calc-rec-warning-text"></span>
