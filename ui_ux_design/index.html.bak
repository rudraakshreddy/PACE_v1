                                        <div class="telemetry-label" style="color: #ccfbf1;">Effective Recovery</div>
                                        <div class="telemetry-val" style="font-size: 1.4rem; color: #ffffff;"><span id="calc-rec-eff-rec">-</span> <span style="font-size: 0.75rem; font-weight: normal; color: #ccfbf1 !important;">%</span></div>
                                    </div>
