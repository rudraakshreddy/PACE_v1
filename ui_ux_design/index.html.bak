                            <i class="fa-solid fa-atom"></i> Year-Wise Performance
                        </button>
                    </div>

                    <!-- Scrollable wrapper for active tab content -->
                    <div id="calc-results-scroll-wrapper" style="overflow-y: auto; max-height: calc(100vh - 185px); flex-grow: 1; padding-right: 0.5rem; display: flex; flex-direction: column; gap: 1rem;">
                        <!-- SUBTAB: Overview -->
                        <div id="calc-content-overview" style="display: flex; flex-direction: column; gap: 1rem; width: 100%; flex-grow: 1;">
                            <!-- UF Overview (if applicable) -->
