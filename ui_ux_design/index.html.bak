                        <!-- SUBTAB: Economics -->
                        <div id="calc-content-economics" style="display: none; flex-direction: column; gap: 1rem; width: 100%;">
                            <!-- Input Parameters -->
                            <section class="card">
                                <div class="card-header">
                                    <h2 class="card-title"><i class="fa-solid fa-sliders"></i> Economic Parameters</h2>
                                </div>
                                <div class="card-content" style="display: grid; grid-template-columns: repeat(4, 1fr); gap: 0.8rem;">
                                    <div class="input-group">
                                        <label for="eco-tariff">Electricity Tariff <span class="unit">â‚¹/kWh</span></label>
                                        <input type="number" id="eco-tariff" value="7.50" step="0.1">
                                    </div>
                                    <div class="input-group">
                                        <label for="eco-mem-cost">Membrane Cost <span class="unit">â‚¹/elem</span></label>
                                        <input type="number" id="eco-mem-cost" value="26880" step="any">
                                    </div>
                                    <div class="input-group">
                                        <label for="eco-ves-cost">Vessel Cost <span class="unit">â‚¹/vessel</span></label>
                                        <input type="number" id="eco-ves-cost" value="48000" step="1000">
                                    </div>
                                    <div class="input-group">
                                        <label for="eco-pump-cost">Pump Cost <span class="unit">â‚¹/kW</span></label>
                                        <input type="number" id="eco-pump-cost" value="96000" step="1000">
                                    </div>
                                    <div class="input-group">
                                        <label for="eco-ic-factor">I&C Factor <span class="unit">%</span></label>
                                        <input type="number" id="eco-ic-factor" value="15" step="1" max="100">
                                    </div>
                                    <div class="input-group">
                                        <label for="eco-cont-factor">Contingency <span class="unit">%</span></label>
                                        <input type="number" id="eco-cont-factor" value="10" step="1" max="100">
                                    </div>
                                    <div class="input-group">
                                        <label for="eco-mem-life">Membrane Life <span class="unit">years</span></label>
                                        <input type="number" id="eco-mem-life" value="5" step="1">
                                    </div>
                                    <div class="input-group">
                                        <label for="eco-avail">Availability <span class="unit">%</span></label>
                                        <input type="number" id="eco-avail" value="90" step="1" max="100">
                                    </div>
                                </div>
                            </section>

                            <div style="display: grid; grid-template-columns: repeat(3, 1fr); gap: 1rem;">
                                <!-- CAPEX -->
                                <section class="card">
                                    <div class="card-header">
                                        <h2 class="card-title"><i class="fa-solid fa-industry"></i> CAPEX Breakdown</h2>
                                    </div>
                                    <div class="card-content" style="padding: 0;">
                                        <table class="report-table" style="width: 100%; border-collapse: collapse;">
                                            <tbody id="eco-capex-tbody">
                                                <tr><td>Membranes</td><td id="eco-capex-mem" style="text-align: right;">-</td></tr>
                                                <tr><td>Pressure Vessels</td><td id="eco-capex-ves" style="text-align: right;">-</td></tr>
                                                <tr><td>HP Pump</td><td id="eco-capex-hp" style="text-align: right;">-</td></tr>
                                                <tr><td>Booster Pumps</td><td id="eco-capex-bp" style="text-align: right;">-</td></tr>
                                                <tr style="border-top: 1px dashed rgba(0, 0, 0, 0.2);">
                                                    <td><strong>Equip. Subtotal</strong></td><td id="eco-capex-sub" style="text-align: right;"><strong>-</strong></td>
                                                </tr>
                                                <tr><td>I&C</td><td id="eco-capex-ic" style="text-align: right;">-</td></tr>
                                                <tr><td>Contingency</td><td id="eco-capex-cont" style="text-align: right;">-</td></tr>
                                            </tbody>
                                        </table>
                                        <div style="padding: 1rem; border-top: 1px solid rgba(0, 0, 0, 0.1); display: flex; justify-content: space-between; align-items: center; background: rgba(56, 189, 248, 0.05);">
                                            <span style="font-size: 1rem; color: #94a3b8;">Total CAPEX</span>
                                            <span id="eco-capex-total" style="font-size: 1.25rem; font-weight: 700; color: #38bdf8;">-</span>
                                        </div>
                                    </div>
                                </section>

                                <!-- OPEX -->
                                <section class="card" style="display: flex; flex-direction: column;">
                                    <div class="card-header">
                                        <h2 class="card-title"><i class="fa-solid fa-plug"></i> OPEX (Annual)</h2>
                                    </div>
                                    <div class="card-content" style="padding: 0; flex: 1;">
                                        <table class="report-table" style="width: 100%; border-collapse: collapse;">
                                            <tbody id="eco-opex-tbody">
                                                <tr><td>Energy Cost</td><td id="eco-opex-energy" style="text-align: right;">-</td></tr>
                                                <tr><td>Membrane Replacement</td><td id="eco-opex-mem" style="text-align: right;">-</td></tr>
                                            </tbody>
                                        </table>
                                    </div>
                                    <div style="padding: 1rem; border-top: 1px solid rgba(0, 0, 0, 0.1); display: flex; justify-content: space-between; align-items: center; background: rgba(167, 139, 250, 0.05);">
                                        <span style="font-size: 1rem; color: #94a3b8;">Total OPEX</span>
                                        <span id="eco-opex-total" style="font-size: 1.25rem; font-weight: 700; color: #a78bfa;">-</span>
                                    </div>
                                </section>

                                <!-- Unit Cost -->
                                <section class="card" style="display: flex; flex-direction: column;">
                                    <div class="card-header">
                                        <h2 class="card-title"><i class="fa-solid fa-droplet"></i> Unit Cost</h2>
                                    </div>
                                    <div class="card-content" style="display: flex; flex-direction: column; justify-content: center; align-items: center; gap: 1rem; flex: 1;">
                                        <div style="text-align: center;">
                                            <div style="font-size: 0.85rem; color: #94a3b8; margin-bottom: 0.25rem;">Annual Production (KL)</div>
                                            <div id="eco-metrics-kl" style="font-size: 1.1rem; color: #e2e8f0; font-weight: 600;">-</div>
                                        </div>
                                        <div style="text-align: center;">
                                            <div style="font-size: 0.85rem; color: #94a3b8; margin-bottom: 0.25rem;">Total Annualised Cost</div>
                                            <div id="eco-metrics-tac" style="font-size: 1.1rem; color: #e2e8f0; font-weight: 600;">-</div>
                                        </div>
                                    </div>
                                    <div style="padding: 1rem; border-top: 1px solid rgba(0, 0, 0, 0.1); display: flex; justify-content: space-between; align-items: center; background: rgba(52, 211, 153, 0.05);">
                                        <span style="font-size: 1rem; color: #94a3b8;">Cost per KL</span>
                                        <span id="eco-metrics-cost-kl" style="font-size: 1.5rem; font-weight: 700; color: #34d399;">-</span>
                                    </div>
                                </section>
                            </div>
                        </div>

                        <!-- SUBTAB: Process Flow Diagram -->
                        <div id="calc-content-pfd" style="display: none; flex-direction: column; gap: 1rem; width: 100%;">
                            <section class="card">
                                <div class="card-header" style="display: flex; justify-content: space-between; align-items: center;">
                                    <h2 class="card-title"><i class="fa-solid fa-project-diagram"></i> Process Flow Diagram</h2>
                                    <button class="btn" style="padding: 0.4rem 1rem; background: var(--success-color); color: white; border: none; border-radius: 4px; cursor: pointer; font-size: 0.85rem;" onclick="exportPFDSVG()">â†“ Export SVG</button>
                                </div>
                                <div class="card-content" style="padding: 1rem; background: var(--bg-color); overflow-x: auto;">
                                    <div id="pfd-svg-container" style="background: var(--card-bg); border-radius: 8px; box-shadow: 0 2px 12px rgba(0,0,0,0.09); margin: 0 auto; width: max-content;"></div>
                                </div>
                            </section>
                            </div>

                        <!-- SUBTAB: Physics Projection -->
                        <div id="calc-content-physics" style="display: none; flex-direction: column; gap: 1rem; width: 100%;">

                            <!-- Year Banner -->
                            <div id="phys-year-banner" style="background: linear-gradient(135deg, #6366f1, #8b5cf6); border-radius: 10px; padding: 0.8rem 1.4rem; display: flex; align-items: center; justify-content: space-between;">
                                <div>
                                    <div style="font-size: 0.7rem; color: rgba(255,255,255,0.7); letter-spacing: 0.1em; text-transform: uppercase; font-weight: 700;">Physics-Based Membrane Performance</div>
                                    <div style="font-size: 1.5rem; font-weight: 800; color: white;" id="phys-banner-title">Year 0 â€” Baseline</div>
                                </div>
                                <div style="text-align: right;">
                                    <div style="font-size: 0.7rem; color: rgba(255,255,255,0.7); text-transform: uppercase; letter-spacing: 0.06em;">Projection Mode</div>
                                    <div style="font-size: 0.85rem; color: white; font-weight: 600;">5-Fouling-Mechanism Model</div>
                                </div>
                            </div>

                            <!-- Comparison Cards: Year 0 vs Year N -->
                            <section class="card">
                                <div class="card-header">
                                    <h2 class="card-title"><i class="fa-solid fa-chart-bar"></i> Performance â€” <span id="phys-card-year-label">Year 0 (Baseline)</span></h2>
                                </div>
                                <div style="display: grid; grid-template-columns: repeat(5, 1fr); gap: 1rem;">
                                    <div class="telemetry-card" style="min-height: 90px; padding: 0.8rem 0.5rem; border: 1.5px solid rgba(99,102,241,0.3);">
                                        <div class="telemetry-label">Feed Pressure</div>
                                        <div class="telemetry-val" style="font-size: 1.3rem;"><span id="phys-card-press">-</span> <span style="font-size: 0.7rem; color: var(--text-secondary);">bar</span></div>
                                        <div id="phys-card-press-delta" style="font-size: 0.72rem; margin-top: 0.2rem; font-weight: 600; color: #f87171;"></div>
                                    </div>
                                    <div class="telemetry-card" style="min-height: 90px; padding: 0.8rem 0.5rem; border: 1.5px solid rgba(99,102,241,0.3);">
                                        <div class="telemetry-label">Permeate Flow</div>
                                        <div class="telemetry-val" style="font-size: 1.3rem;"><span id="phys-card-flow">-</span> <span style="font-size: 0.7rem; color: var(--text-secondary);">mÂ³/h</span></div>
                                        <div id="phys-card-flow-delta" style="font-size: 0.72rem; margin-top: 0.2rem; font-weight: 600; color: #34d399;"></div>
                                    </div>
                                    <div class="telemetry-card" style="min-height: 90px; padding: 0.8rem 0.5rem; border: 1.5px solid rgba(99,102,241,0.3);">
                                        <div class="telemetry-label">NPF</div>
                                        <div class="telemetry-val" style="font-size: 1.3rem;"><span id="phys-card-npf">-</span></div>
                                        <div id="phys-card-npf-delta" style="font-size: 0.72rem; margin-top: 0.2rem; font-weight: 600; color: #f87171;"></div>
                                    </div>
                                    <div class="telemetry-card" style="min-height: 90px; padding: 0.8rem 0.5rem; border: 1.5px solid rgba(99,102,241,0.3);">
                                        <div class="telemetry-label">FRI</div>
                                        <div class="telemetry-val" style="font-size: 1.3rem;"><span id="phys-card-fri">-</span></div>
                                        <div id="phys-card-fri-label" style="font-size: 0.72rem; margin-top: 0.2rem; color: var(--text-secondary);">Fouling Resistance Index</div>
                                    </div>
                                    <div class="telemetry-card" style="min-height: 90px; padding: 0.8rem 0.5rem; border: 1.5px solid rgba(99,102,241,0.3);">
                                        <div class="telemetry-label">B Relative</div>
                                        <div class="telemetry-val" style="font-size: 1.3rem;"><span id="phys-card-brel">-</span></div>
                                        <div id="phys-card-brel-label" style="font-size: 0.72rem; margin-top: 0.2rem; color: var(--text-secondary);">Salt Perm. Degradation</div>
                                    </div>
                                </div>

                                <!-- Additional metrics row -->
                                <div style="display: grid; grid-template-columns: repeat(4, 1fr); gap: 0.8rem; margin-top: 0.8rem; padding-top: 0.8rem; border-top: 1px solid var(--card-border);">
                                    <div style="text-align: center;">
                                        <div style="font-size: 0.68rem; text-transform: uppercase; letter-spacing: 0.06em; color: var(--text-muted);">Recovery</div>
                                        <div style="font-size: 1.1rem; font-weight: 700;"><span id="phys-card-rec">-</span>%</div>
                                    </div>
                                    <div style="text-align: center;">
                                        <div style="font-size: 0.68rem; text-transform: uppercase; letter-spacing: 0.06em; color: var(--text-muted);">Permeate TDS</div>
                                        <div style="font-size: 1.1rem; font-weight: 700;"><span id="phys-card-tds">-</span> <span style="font-size: 0.75rem; font-weight: normal;">mg/L</span></div>
                                    </div>
                                    <div style="text-align: center;">
                                        <div style="font-size: 0.68rem; text-transform: uppercase; letter-spacing: 0.06em; color: var(--text-muted);">SEC</div>
                                        <div style="font-size: 1.1rem; font-weight: 700;"><span id="phys-card-sec">-</span> <span style="font-size: 0.75rem; font-weight: normal;">kWh/mÂ³</span></div>
                                    </div>
                                    <div style="text-align: center;">
                                        <div style="font-size: 0.68rem; text-transform: uppercase; letter-spacing: 0.06em; color: var(--text-muted);">CIP Events</div>
                                        <div style="font-size: 1.1rem; font-weight: 700; color: #f59e0b;"><span id="phys-card-cips">-</span></div>
                                    </div>
                                </div>
                            </section>

                            <!-- Year-by-Year Table -->
                            <section class="card">
                                <div class="card-header">
                                    <h2 class="card-title"><i class="fa-solid fa-table"></i> Year-by-Year Performance Table</h2>
                                </div>
                                <div class="card-content" style="overflow-x: auto; padding: 0;">
                                    <table class="report-table" style="width: 100%; border-collapse: collapse; white-space: nowrap;">
                                        <thead>
                                            <tr>
                                                <th style="min-width: 55px;">Year</th>
                                                <th>Qp (mÂ³/h)</th>
                                                <th>Rec. (%)</th>
                                                <th>P_feed (bar)</th>
                                                <th>TDS (mg/L)</th>
                                                <th>SEC (kWh/mÂ³)</th>
                                                <th>NPF</th>
                                                <th>NSP</th>
                                                <th>FRI</th>
                                                <th>B_rel</th>
                                                <th title="Cleaning-in-Place: triggered when fouling causes NPF &lt; 0.85 or FRI &gt; 0.60 or feed pressure rises &gt;35% above baseline">CIP Status</th>
                                                <th title="Cumulative number of CIP cleaning cycles performed up to this year">CIPs (Total)</th>
                                            </tr>
                                        </thead>
                                        <tbody id="phys-annual-tbody">
                                        </tbody>
                                    </table>
                                </div>
                            </section>

                            <!-- Charts Row -->
                            <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 1rem;">
                                <!-- NPF/NSP Trend -->
                                <section class="card">
                                    <div class="card-header">
                                        <h2 class="card-title"><i class="fa-solid fa-chart-line"></i> NPF & NSP Trend</h2>
                                    </div>
                                    <div style="padding: 0.5rem;">
                                        <canvas id="phys-npf-chart" height="180"></canvas>
                                    </div>
                                </section>

                                <!-- Fouling Mechanism Chart -->
                                <section class="card">
                                    <div class="card-header">
                                        <h2 class="card-title"><i class="fa-solid fa-layer-group"></i> Fouling Mechanisms</h2>
                                    </div>
                                    <div style="padding: 0.5rem;">
                                        <canvas id="phys-fouling-chart" height="180"></canvas>
                                    </div>
                                </section>
                            </div>

                            <!-- Feed Pressure & SEC Trend -->
                            <section class="card">
                                <div class="card-header">
                                    <h2 class="card-title"><i class="fa-solid fa-gauge-high"></i> Feed Pressure & SEC Trend</h2>
                                </div>
                                <div style="padding: 0.5rem;">
                                    <canvas id="phys-pressure-chart" height="130"></canvas>
                                </div>
                            </section>

                            <!-- Fouling Resistance Breakdown at Selected Year -->
                            <section class="card">
                                <div class="card-header">
                                    <h2 class="card-title"><i class="fa-solid fa-bacteria"></i> Fouling Resistance Breakdown â€” <span id="phys-fouling-year-label">Year 0</span></h2>
                                </div>
                                <div class="card-content" style="padding: 0;">
                                    <table class="report-table" style="width: 100%; border-collapse: collapse;">
                                        <thead>
                                            <tr>
                                                <th style="text-align: left; padding: 0.5rem;">Mechanism</th>
                                                <th>Resistance (mâ»Â¹)</th>
                                                <th>Contribution (%)</th>
                                                <th>Status</th>
                                            </tr>
                                        </thead>
                                        <tbody id="phys-fouling-tbody">
                                        </tbody>
                                    </table>
                                </div>
                            </section>

                            <!-- Wall-SI vs Bulk-SI Comparison -->
                            <section class="card">
                                <div class="card-header">
                                    <h2 class="card-title"><i class="fa-solid fa-vial-circle-check"></i> Wall-Level Saturation Indices â€” <span id="phys-si-year-label">Year 0</span></h2>
                                </div>
                                <p style="font-size: 0.78rem; color: #64748b; margin: 0 1rem 0.5rem; padding: 0.4rem 0.8rem; background: rgba(99,102,241,0.05); border-radius: 5px; border-left: 3px solid #6366f1;">
                                    Wall-SI includes concentration polarisation (CP) enhancement and is therefore higher than bulk concentrate SI. Year-on-year increase reflects reduced crossflow from fouling.
                                </p>
                                <div class="card-content" style="padding: 0;">
                                    <table class="report-table" style="width: 100%; border-collapse: collapse;">
                                        <thead>
                                            <tr>
                                                <th style="text-align: left; padding: 0.5rem;">Mineral</th>
                                                <th>Bulk SI</th>
                                                <th>Wall SI (Yr 0)</th>
                                                <th>Wall SI (Selected Yr)</th>
                                                <th>Risk</th>
                                            </tr>
                                        </thead>
                                        <tbody id="phys-si-tbody">
                                        </tbody>
                                    </table>
                                </div>
                            </section>

                        </div>

                    </div>
                </div>
            </main>
        </div>

        <div class="dashboard" id="report-panel-view" style="display: none; grid-template-columns: 1fr; gap: 0.6rem;">
            <main class="data-entry" style="display: flex; flex-direction: column; gap: 0.6rem; grid-column: span 1;">
                <section class="card">
                    <div class="card-header" style="display: flex; justify-content: space-between; align-items: center;">
                        <h2 class="card-title"><i class="fa-solid fa-file-pdf"></i> Comprehensive Project Summary Report</h2>
                        <button class="btn" id="wave-report-download-btn" style="width: auto; padding: 0.35rem 1.2rem; font-size: 0.85rem; background: #c0392b; color: white; border: none; border-radius: 4px; cursor: pointer; font-weight: 600; display: flex; align-items: center; gap: 0.5rem;" onclick="downloadWaveReport()">
                            <i class="fa-solid fa-file-pdf"></i> Download Report (.pdf)
                        </button>
                    </div>
                    
                    <div class="report-content" id="printable-report-area" style="padding: 0; background: #ffffff; border-radius: 4px; border: 1px solid #e0e0e0; height: 800px; display: flex; flex-direction: column; justify-content: center; align-items: center; text-align: center; margin-top: 1rem;">
                        <div id="report-preview-placeholder" style="color: #64748b;">
                            <i class="fa-solid fa-file-pdf" style="font-size: 3rem; margin-bottom: 1rem; color: #cbd5e1;"></i>
                            <p style="font-size: 1.1rem; font-weight: 500;">No Report Generated Yet</p>
                            <p style="font-size: 0.9rem; margin-top: 0.5rem;">Please run a system calculation first, then the exact PDF report preview will appear here.</p>
                        </div>
                        <iframe id="pdf-preview-iframe" style="width: 100%; height: 100%; border: none; display: none;"></iframe>
                    </div>
                </section>
            </main>
        </div>

        <div class="dashboard" id="aging-panel-view" style="display: none; grid-template-columns: 460px 1fr; gap: 0.6rem;">
            <!-- Left Column: Aging Inputs -->
            <main class="data-entry" style="display: flex; flex-direction: column; gap: 0.6rem; grid-column: span 1; overflow-y: auto; max-height: calc(100vh - 140px); padding-right: 0.3rem;">
                <!-- System Configuration -->
                <section class="card">
                    <div class="card-header">
                        <h2 class="card-title"><i class="fa-solid fa-gears"></i> Aging Configuration</h2>
                    </div>
                    <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 0.5rem; margin-bottom: 0.5rem;">
                        <div class="input-group">
                            <label for="aging-design-life">Design Life (months)</label>
                            <input type="number" id="aging-design-life" value="60" min="12" max="120" step="1">
                        </div>
                        <div class="input-group">
                            <label for="aging-sim-mode">Simulation Mode</label>
                            <select id="aging-sim-mode">
                                <option value="constant_recovery" selected>Constant Recovery</option>
                                <option value="constant_pressure">Constant Pressure</option>
                            </select>
                        </div>
                        <div class="input-group">
                            <label for="aging-cip-mode">CIP Mode</label>
                            <select id="aging-cip-mode">
                                <option value="scheduled" selected>Scheduled</option>
                                <option value="performance">Performance-Triggered</option>
                            </select>
                        </div>
                        <div class="input-group">
                            <label for="aging-cip-interval-display">CIP Interval <span class="unit">months</span></label>
                            <div style="display:flex; align-items:center; gap:0.5rem;">
                                <input type="number" id="aging-cip-interval" value="0" min="0" max="60" step="1"
                                    style="display:none;" aria-hidden="true">
                                <input type="number" id="aging-cip-interval-display"
                                    style="background:var(--surface-2,#1e2235); border:1.5px solid #6366f1; color:var(--text-muted,#94a3b8); border-radius:6px; padding:0.35rem 0.5rem; width:5rem; font-size:0.85rem;"
                                    min="0" max="60" step="1" value="0"
                                    title="Shared with Year-wise Projection tab"
                                    oninput="document.getElementById('phys-cip-interval').value=this.value; document.getElementById('aging-cip-interval').value=this.value*30;">
                                <span style="font-size:0.75rem; color:#6366f1; font-weight:600;">â†” synced with Year-wise tab</span>
                            </div>
                        </div>
                    </div>
                    <div style="padding: 0.4rem 0;">
                        <label style="display: flex; align-items: center; gap: 0.5rem; cursor: pointer; font-size: 0.82rem; color: var(--text-muted);">
                            <input type="checkbox" id="aging-antiscalant" checked style="accent-color: var(--accent); width: 16px; height: 16px;">
                            Antiscalant Dosed
                        </label>
                    </div>
                </section>

                <!-- Feed Quality History -->
                <section class="card">
                    <div class="card-header">
                        <h2 class="card-title"><i class="fa-solid fa-flask-vial"></i> Feed Quality History</h2>
                    </div>
                    <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 0.5rem;">
                        <div class="input-group">
                            <label for="aging-sdi">SDIâ‚â‚…</label>
                            <input type="number" id="aging-sdi" value="3.0" min="0.5" max="6.0" step="0.1">
                        </div>
                        <div class="input-group">
                            <label for="aging-toc">TOC (mg/L)</label>
                            <input type="number" id="aging-toc" value="2.0" min="0" max="20" step="0.1">
                        </div>
                        <div class="input-group">
                            <label for="aging-temp">Temperature (Â°C)</label>
                            <input type="number" id="aging-temp" value="28" min="5" max="45" step="1">
                        </div>
                        <div class="input-group">
                            <label for="aging-cl2">Free Clâ‚‚ Post-SBS (mg/L)</label>
