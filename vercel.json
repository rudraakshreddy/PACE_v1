{
  "version": 2,
  "builds": [
    {
      "src": "backend/server.py",
      "use": "@vercel/python"
    },
    {
      "src": "ui_ux_design/**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "backend/server.py"
    },
    {
      "src": "/(.*)",
      "dest": "ui_ux_design/$1"
    }
  ],
  "env": {
    "MPLCONFIGDIR": "/tmp",
    "MPLBACKEND": "Agg"
  },
  "functions": {
    "backend/server.py": {
      "maxDuration": 60,
      "memory": 1024
    }
  }
}
